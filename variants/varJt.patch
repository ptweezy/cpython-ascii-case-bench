+    @support.skip_if_pgo_task
+    def test_lower_upper_ascii(self):
+        # gh-161155: lower() and upper() convert ASCII strings a machine
+        # word at a time.  Put a letter or a character next to the letter
+        # ranges at every position of strings around those sizes.
+        for n in (*range(1, 9), 15, 16, 17, 31, 32, 33):
+            for i in range(n):
+                for c in 'AZaz@[`{':
+                    s = '0' * i + c + '9' * (n - i - 1)
+                    self.assertEqual(s.lower(), s[:i] + c.lower() + s[i+1:])
+                    self.assertEqual(s.upper(), s[:i] + c.upper() + s[i+1:])
+
