+    @support.skip_if_pgo_task
+    def test_lower_upper_every_byte(self):
+        # gh-161155: lower() and upper() convert a machine word at a time.
+        # Put every byte value at every position of lengths around one to
+        # four words, including unaligned bytearray buffers.
+        lo = b'abcdefghijklmnopqrstuvwxyz'
+        up = b'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
+        to_lower = bytes.maketrans(up, lo)
+        to_upper = bytes.maketrans(lo, up)
+        bg = b'aZ@[`{zA\x80\xc1\xda\xe1\xfa\xff\x7f\x00' * 3
+        for n in (*range(1, 9), 15, 16, 17, 31, 32, 33):
+            b = self.type2test(bg[:n])
+            self.assertEqual(b.capitalize(), b'A' + b[1:].translate(to_lower))
+            for r in range(256):
+                b = self.type2test((r + c) % 256 for c in bg[:n])
+                self.assertEqual(b.lower(), b.translate(to_lower))
+                self.assertEqual(b.upper(), b.translate(to_upper))
+        data = bytes(range(256)) * 2
+        for k in range(16):
+            b = bytearray(k) + data
+            del b[:k]  # moves the start of the buffer
+            self.assertEqual(b.lower(), data.translate(to_lower))
+            self.assertEqual(b.upper(), data.translate(to_upper))
+
 
 class BytesTest(BaseBytesTest, unittest.TestCase):
     type2test = bytes
