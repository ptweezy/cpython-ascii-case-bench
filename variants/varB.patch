--- a/Objects/bytes_methods.c
+++ b/Objects/bytes_methods.c
@@ -242,6 +242,116 @@
 }
 
 
+/* Return 0x20 in each byte of x that lies in first..first+25, else 0,
+   given 0x80 - first and 0x80 - first - 26 in every byte of ge and gt.
+   For a byte b < 0x80, b + (0x80 - first) has its high bit set iff
+   b >= first, and b + (0x80 - first - 26) iff b > first + 25; neither
+   sum carries.  "& ~x" drops bytes >= 0x80. */
+static inline Py_ALWAYS_INLINE size_t
+ascii_case_bits(size_t x, size_t ge, size_t gt)
+{
+    const size_t ones = (size_t)-1 / 0xff;  /* 0x01 in every byte */
+    size_t b = x & (0x7f * ones);
+    size_t ge_first = b + ge;
+    size_t gt_last = b + gt;
+    return (ge_first & ~gt_last & ~x & (0x80 * ones)) >> 2;
+}
+
+static inline Py_ALWAYS_INLINE void
+ascii_case_word(char *result, const char *cptr, Py_ssize_t i,
+                size_t ge, size_t gt)
+{
+    size_t x;
+    memcpy(&x, cptr + i, sizeof(x));
+    x ^= ascii_case_bits(x, ge, gt);
+    memcpy(result + i, &x, sizeof(x));
+}
+
+#if defined(__GNUC__) && (defined(__x86_64__) || defined(__aarch64__)) \
+    && SIZEOF_SIZE_T == 8
+/* Convert a block as one GNU vector of words: 32 bytes with AVX2 or on
+   arm64 (two NEON registers, which unrolls the loop once), else 16 bytes
+   (SSE2; gcc splits a 32-byte vector poorly there).  A vector type keeps
+   this SIMD also where gcc and clang optimize for size, as in PGO builds
+   whose training rarely runs this loop.  Constants are splatted
+   explicitly: older clang rejects mixing scalars and vectors
+   (gh-148474). */
+#if defined(__AVX2__) || defined(__aarch64__)
+#define ASCII_CASE_BLOCK 32
+typedef uint64_t ascii_case_vec __attribute__((vector_size(32)));
+#define ASCII_CASE_SPLAT(c) ((ascii_case_vec){(c), (c), (c), (c)})
+#else
+#define ASCII_CASE_BLOCK 16
+typedef uint64_t ascii_case_vec __attribute__((vector_size(16)));
+#define ASCII_CASE_SPLAT(c) ((ascii_case_vec){(c), (c)})
+#endif
+
+static inline Py_ALWAYS_INLINE void
+ascii_case_block(char *result, const char *cptr, Py_ssize_t i,
+                 size_t ge, size_t gt)
+{
+    ascii_case_vec x, b;
+    memcpy(&x, cptr + i, sizeof(x));
+    b = x & ASCII_CASE_SPLAT(0x7f7f7f7f7f7f7f7fULL);
+    x ^= ((b + ASCII_CASE_SPLAT(ge)) & ~(b + ASCII_CASE_SPLAT(gt)) & ~x
+          & ASCII_CASE_SPLAT(0x8080808080808080ULL)) >> ASCII_CASE_SPLAT(2);
+    memcpy(result + i, &x, sizeof(x));
+}
+#elif defined(_MSC_VER) && !defined(__clang__) && SIZEOF_SIZE_T == 8
+/* Convert 16 bytes as an array of two words, which MSVC vectorizes on
+   x64 also where PGO finds this loop cold, unlike the word loop below.
+   32-bit targets keep the word loop: there the block of four words is
+   scalar in PGO builds and slower than the word loop otherwise. */
+#define ASCII_CASE_BLOCK 16
+
+static inline Py_ALWAYS_INLINE void
+ascii_case_block(char *result, const char *cptr, Py_ssize_t i,
+                 size_t ge, size_t gt)
+{
+    size_t x[16 / SIZEOF_SIZE_T];
+    memcpy(x, cptr + i, sizeof(x));
+    for (size_t k = 0; k < Py_ARRAY_LENGTH(x); k++) {
+        x[k] ^= ascii_case_bits(x[k], ge, gt);
+    }
+    memcpy(result + i, x, sizeof(x));
+}
+#endif
+
+/* Requires len >= SIZEOF_SIZE_T.  The last block or word may overlap the
+   ones before it; converting a byte twice is harmless.  Not inlined, so
+   that short strings skip its setup. */
+static Py_NO_INLINE void
+ascii_case_words(char *result, const char *cptr, Py_ssize_t len,
+                 unsigned char first)
+{
+    const size_t ones = (size_t)-1 / 0xff;
+    size_t ge = (0x80 - first) * ones, gt = (0x80 - first - 26) * ones;
+    Py_ssize_t i;
+#ifdef ASCII_CASE_BLOCK
+    if (len >= ASCII_CASE_BLOCK) {
+        for (i = 0; i < len - ASCII_CASE_BLOCK; i += ASCII_CASE_BLOCK) {
+            ascii_case_block(result, cptr, i, ge, gt);
+        }
+        ascii_case_block(result, cptr, len - ASCII_CASE_BLOCK, ge, gt);
+        return;
+    }
+#endif
+#if defined(_MSC_VER) && !defined(__clang__)
+    /* MSVC only vectorizes loops that count by one; elsewhere such a loop
+       gets post-indexed accesses, slow on Apple cores.  Dividing unsigned
+       avoids an idiv in code optimized for size. */
+    Py_ssize_t n = (size_t)(len - 1) / SIZEOF_SIZE_T;
+    for (i = 0; i < n; i++) {
+        ascii_case_word(result, cptr, i * SIZEOF_SIZE_T, ge, gt);
+    }
+#else
+    for (i = 0; i < len - SIZEOF_SIZE_T; i += SIZEOF_SIZE_T) {
+        ascii_case_word(result, cptr, i, ge, gt);
+    }
+#endif
+    ascii_case_word(result, cptr, len - SIZEOF_SIZE_T, ge, gt);
+}
+
