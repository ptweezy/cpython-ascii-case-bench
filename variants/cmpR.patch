+        ascii_case_words(result, cptr, len, 'A');
+        return;
+    }
     for (i = 0; i < len; i++) {
         result[i] = Py_TOLOWER((unsigned char) cptr[i]);
     }
@@ -268,6 +322,10 @@ _Py_bytes_upper(char *result, const char *cptr, Py_ssize_t len)
 {
