+#define ASCII_ONES ((uint64_t)-1 / 0xff)  /* 0x01 in every byte */
+
+/* Return x with 0x20 XORed into each byte valued first..first+25, given
+   0x80 - first and 0x80 - first - 26 in every byte of ge and gt.  For a
+   byte b < 0x80, b + ge has its high bit set iff b >= first, and b + gt
+   iff b > first + 25; neither sum carries.  "| x" drops bytes >= 0x80. */
+static inline Py_ALWAYS_INLINE uint64_t
+ascii_case_conv(uint64_t x, uint64_t ge, uint64_t gt)
+{
+    const uint64_t high = 0x80 * ASCII_ONES;
+    uint64_t b = x & ~high;
+    return x ^ (((b + ge) & ~((b + gt) | x) & high) >> 2);
+}
+
+/* Requires len > 16.  Convert 16-byte blocks, the last one overlapping
+   the one before.  Each compiler vectorizes its own form of a block,
+   also where PGO finds this code cold: gcc separate words, clang an
+   array, MSVC only a loop. */
+static Py_NO_INLINE void
+ascii_case_blocks(char *result, const char *cptr, size_t len, uint64_t ge)
+{
+    uint64_t gt = ge - 26 * ASCII_ONES;
+    for (size_t i = 0; ; i += 16) {
+        if (i > len - 16) {
+            if (i == len) {
+                break;
+            }
+            i = len - 16;
+        }
+#if defined(__GNUC__) && !defined(__clang__)
+        uint64_t x, y;
+        memcpy(&x, cptr + i, 8);
+        memcpy(&y, cptr + i + 8, 8);
+        x = ascii_case_conv(x, ge, gt);
+        y = ascii_case_conv(y, ge, gt);
+        memcpy(result + i, &x, 8);
+        memcpy(result + i + 8, &y, 8);
+#else
+        uint64_t x[2];
+        memcpy(x, cptr + i, 16);
+#  ifdef __clang__
+        x[0] = ascii_case_conv(x[0], ge, gt);
+        x[1] = ascii_case_conv(x[1], ge, gt);
+#  else
+        for (int k = 0; k < 2; k++) {
+            x[k] = ascii_case_conv(x[k], ge, gt);
+        }
+#  endif
+        memcpy(result + i, x, 16);
+#endif
+    }
+}
+
+/* Requires 8 < len <= 16.  Convert two words that may overlap.  Not
+   part of ascii_case(), whose shorter strings would pay for saving the
+   registers that this needs. */
+static Py_NO_INLINE void
+ascii_case_words(char *result, const char *cptr, size_t len, uint64_t ge)
+{
+    uint64_t gt = ge - 26 * ASCII_ONES;
+    uint64_t x, y;
+    memcpy(&x, cptr, 8);
+    memcpy(&y, cptr + len - 8, 8);
+    x = ascii_case_conv(x, ge, gt);
+    y = ascii_case_conv(y, ge, gt);
+    memcpy(result, &x, 8);
+    memcpy(result + len - 8, &y, 8);
+}
+
+/* Requires len > 4; ge holds 0x80 - first in every byte.  Up to 8 bytes
+   take two 4-byte words that may overlap.  The helpers are not inlined,
+   so that shorter strings skip their setup. */
+static Py_NO_INLINE void
+ascii_case(char *result, const char *cptr, size_t len, uint64_t ge)
+{
+    if (len <= 8) {
+        uint32_t lo, hi;
+        memcpy(&lo, cptr, 4);
+        memcpy(&hi, cptr + len - 4, 4);
+        uint64_t x = ascii_case_conv(lo | (uint64_t)hi << 32,
+                                     ge, ge - 26 * ASCII_ONES);
+        lo = (uint32_t)x;
+        hi = (uint32_t)(x >> 32);
+        memcpy(result, &lo, 4);
+        memcpy(result + len - 4, &hi, 4);
+    }
+    else if (len <= 16) {
+        ascii_case_words(result, cptr, len, ge);
+    }
+    else {
+        ascii_case_blocks(result, cptr, len, ge);
+    }
+}
+
+
