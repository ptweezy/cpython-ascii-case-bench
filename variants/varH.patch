diff --git a/Objects/bytes_methods.c b/Objects/bytes_methods.c
index 414afeb..19483ba 100644
--- a/Objects/bytes_methods.c
+++ b/Objects/bytes_methods.c
@@ -242,6 +242,53 @@ _Py_bytes_istitle(const char *cptr, Py_ssize_t len)
 }
 
 
+/* Return 0x20 in each byte of x that lies in first..first+25, else 0,
+   given 0x80 - first and 0x80 - first - 26 in every byte of ge and gt.
+   For a byte b < 0x80, b + (0x80 - first) has its high bit set iff
+   b >= first, and b + (0x80 - first - 26) iff b > first + 25; neither
+   sum carries.  "& ~x" drops bytes >= 0x80. */
+static inline Py_ALWAYS_INLINE size_t
+ascii_case_bits(size_t x, size_t ge, size_t gt)
+{
+    const size_t ones = (size_t)-1 / 0xff;  /* 0x01 in every byte */
+    size_t b = x & (0x7f * ones);
+    size_t ge_first = b + ge;
+    size_t gt_last = b + gt;
+    return (ge_first & ~gt_last & ~x & (0x80 * ones)) >> 2;
+}
+
+static inline Py_ALWAYS_INLINE void
+ascii_case_word(char *result, const char *cptr, size_t ge, size_t gt)
+{
+    size_t x;
+    memcpy(&x, cptr, sizeof(x));
+    x ^= ascii_case_bits(x, ge, gt);
+    memcpy(result, &x, sizeof(x));
+}
+
+/* Requires len >= SIZEOF_SIZE_T.  The last word, converted first, may
+   overlap the others; converting a byte twice is harmless.  Not inlined,
+   so that short strings skip its setup.  The loop indexes whole words,
+   counting by one, with its constants computed outside it: MSVC only
+   vectorizes it in this form, and it stays as short as before where
+   nothing vectorizes it. */
+static Py_NO_INLINE void
+ascii_case_words(char *result, const char *cptr, Py_ssize_t len,
+                 unsigned char first)
+{
+    typedef char word[SIZEOF_SIZE_T];
+    word *rw = (word *)result;
+    const word *cw = (const word *)cptr;
+    const size_t ones = (size_t)-1 / 0xff;
+    size_t ge = (0x80 - first) * ones, gt = (0x80 - first - 26) * ones;
+    Py_ssize_t i, n = (Py_ssize_t)((size_t)(len - 1) / SIZEOF_SIZE_T);
+    ascii_case_word(result + len - SIZEOF_SIZE_T, cptr + len - SIZEOF_SIZE_T,
+                    ge, gt);
+    for (i = 0; i < n; i++) {
+        ascii_case_word(rw[i], cw[i], ge, gt);
+    }
+}
+
 PyDoc_STRVAR_shared(_Py_lower__doc__,
 "B.lower() -> copy of B\n\
 \n\
@@ -252,6 +299,10 @@ _Py_bytes_lower(char *result, const char *cptr, Py_ssize_t len)
 {
     Py_ssize_t i;
 
+    if (len >= SIZEOF_SIZE_T) {
+        ascii_case_words(result, cptr, len, 'A');
+        return;
+    }
     for (i = 0; i < len; i++) {
         result[i] = Py_TOLOWER((unsigned char) cptr[i]);
     }
@@ -268,6 +319,10 @@ _Py_bytes_upper(char *result, const char *cptr, Py_ssize_t len)
 {
     Py_ssize_t i;
 
+    if (len >= SIZEOF_SIZE_T) {
+        ascii_case_words(result, cptr, len, 'a');
+        return;
+    }
     for (i = 0; i < len; i++) {
         result[i] = Py_TOUPPER((unsigned char) cptr[i]);
     }
