diff --git a/Objects/bytes_methods.c b/Objects/bytes_methods.c
index 414afeb..7ac915b 100644
--- a/Objects/bytes_methods.c
+++ b/Objects/bytes_methods.c
@@ -242,6 +242,62 @@ _Py_bytes_istitle(const char *cptr, Py_ssize_t len)
 }
 
 
+#if SIZEOF_SIZE_T == 8
+/* Return x with 0x20 XORed into each byte valued first..first+25, given
+   0x80 - first and 0x80 - first - 26 in every byte of ge and gt.  For a
+   byte b < 0x80, b + ge has its high bit set iff b >= first, and b + gt
+   iff b > first + 25; neither sum carries.  "| x" drops bytes >= 0x80. */
+static inline Py_ALWAYS_INLINE uint64_t
+ascii_case_conv(uint64_t x, uint64_t ge, uint64_t gt)
+{
+    const uint64_t high = 0x8080808080808080;
+    uint64_t b = x & ~high;
+    return x ^ (((b + ge) & ~((b + gt) | x) & high) >> 2);
+}
+
+/* Convert len >= 16 bytes in 16-byte blocks, the last one overlapping the
+   one before.  The compilers vectorize different forms of a block, also
+   where PGO finds this code cold: gcc only separate words, MSVC only a
+   loop, clang an array without a loop.  Not inlined, so that short strings
+   skip the setup. */
+static Py_NO_INLINE void
+ascii_case_blocks(char *result, const char *cptr, Py_ssize_t len,
+                  uint64_t first)
+{
+    uint64_t ge = (0x80 - first) * 0x0101010101010101;
+    uint64_t gt = (0x80 - 26 - first) * 0x0101010101010101;
+    for (Py_ssize_t i = 0; ; i += 16) {
+        if (i > len - 16) {
+            if (i == len) {
+                break;
+            }
+            i = len - 16;
+        }
+#if defined(__GNUC__) && !defined(__clang__)
+        uint64_t x, y;
+        memcpy(&x, cptr + i, 8);
+        memcpy(&y, cptr + i + 8, 8);
+        x = ascii_case_conv(x, ge, gt);
+        y = ascii_case_conv(y, ge, gt);
+        memcpy(result + i, &x, 8);
+        memcpy(result + i + 8, &y, 8);
+#else
+        uint64_t x[2];
+        memcpy(x, cptr + i, 16);
+#  ifdef __clang__
+        x[0] = ascii_case_conv(x[0], ge, gt);
+        x[1] = ascii_case_conv(x[1], ge, gt);
+#  else
+        for (int k = 0; k < 2; k++) {
+            x[k] = ascii_case_conv(x[k], ge, gt);
+        }
+#  endif
+        memcpy(result + i, x, 16);
+#endif
+    }
+}
+#endif
+
 PyDoc_STRVAR_shared(_Py_lower__doc__,
 "B.lower() -> copy of B\n\
 \n\
