 }
 
 
+/* Only on x86-64: elsewhere the short path below was measured slower than
+   the byte loop at some lengths (aarch64), or unaligned loads or 64-bit
+   constants are expensive. */
+#if SIZEOF_SIZE_T == 8 && (defined(__x86_64__) || defined(_M_X64))
+#define ASCII_CASE_BLOCKS
+/* Return x with 0x20 XORed into each byte valued first..first+25, given
+   0x80 - first and 0x80 - first - 26 in every byte of ge and gt.  For a
+   byte b < 0x80, b + ge has its high bit set iff b >= first, and b + gt
+   iff b > first + 25; neither sum carries.  "| x" drops bytes >= 0x80. */
+static inline Py_ALWAYS_INLINE uint64_t
+ascii_case_conv(uint64_t x, uint64_t ge, uint64_t gt)
+{
+    const uint64_t high = 0x8080808080808080ULL;
+    uint64_t b = x & ~high;
+    return x ^ (((b + ge) & ~((b + gt) | x) & high) >> 2);
+}
+
+/* Convert len >= 16 bytes in 16-byte blocks, the last one ending at len.
+   Compilers vectorize different forms of a block in some builds (gcc 16
+   with PGO only separate words, clang with -Os or _FORTIFY_SOURCE only an
+   array without a loop, MSVC only a loop), so each gets its own. */
+static Py_NO_INLINE void
+ascii_case_blocks(char *result, const char *cptr, Py_ssize_t len,
+                  uint64_t ge)
+{
+    uint64_t gt = ge - 26 * 0x0101010101010101ULL;
+    for (Py_ssize_t i = 0; ; i += 16) {
+        if (i > len - 16) {
+            if (i == len) {
+                break;
+            }
+            i = len - 16;
+        }
+#if defined(__GNUC__) && !defined(__clang__)
+        uint64_t x, y;
+        memcpy(&x, cptr + i, 8);
+        memcpy(&y, cptr + i + 8, 8);
+        x = ascii_case_conv(x, ge, gt);
+        y = ascii_case_conv(y, ge, gt);
+        memcpy(result + i, &x, 8);
+        memcpy(result + i + 8, &y, 8);
+#else
+        uint64_t x[2];
+        memcpy(x, cptr + i, 16);
+#  ifdef __clang__
+        x[0] = ascii_case_conv(x[0], ge, gt);
+        x[1] = ascii_case_conv(x[1], ge, gt);
+#  else
+        for (int k = 0; k < 2; k++) {
+            x[k] = ascii_case_conv(x[k], ge, gt);
+        }
+#  endif
+        memcpy(result + i, x, 16);
+#endif
+    }
+}
+
+/* Convert 8 <= len < 16 bytes as two overlapping words. */
+static Py_NO_INLINE void
+ascii_case_words(char *result, const char *cptr, Py_ssize_t len,
+                 uint64_t ge)
+{
+    uint64_t gt = ge - 26 * 0x0101010101010101ULL;
+    uint64_t x, y;
+    memcpy(&x, cptr, 8);
+    memcpy(&y, cptr + len - 8, 8);
+    x = ascii_case_conv(x, ge, gt);
+    y = ascii_case_conv(y, ge, gt);
+    memcpy(result, &x, 8);
+    memcpy(result + len - 8, &y, 8);
+}
+
+/* Convert len >= 6 bytes, given 0x80 - first in every byte of ge: up to 7
+   as one word made of two overlapping halves, up to 15 as two overlapping
+   words, longer ones in 16-byte blocks. */
+static Py_NO_INLINE void
+ascii_case_long(char *result, const char *cptr, Py_ssize_t len,
+                uint64_t ge)
+{
+    uint64_t gt = ge - 26 * 0x0101010101010101ULL;
+    if (len < 8) {
+        uint32_t a, b;
+        memcpy(&a, cptr, 4);
+        memcpy(&b, cptr + len - 4, 4);
+        uint64_t x = ascii_case_conv(a | (uint64_t)b << 32, ge, gt);
+        a = (uint32_t)x;
+        b = (uint32_t)(x >> 32);
+        memcpy(result, &a, 4);
+        memcpy(result + len - 4, &b, 4);
+        return;
+    }
+    if (len >= 16) {
+        ascii_case_blocks(result, cptr, len, ge);
+        return;
+    }
+    ascii_case_words(result, cptr, len, ge);
+}
+#endif
+
+
