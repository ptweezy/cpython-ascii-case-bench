 void
 _Py_bytes_lower(char *result, const char *cptr, Py_ssize_t len)
 {
+#ifdef ASCII_CASE_BLOCKS
+    if (len > 0) {
+        if (len >= 6) {
+            ascii_case_long(result, cptr, len, 0x3f3f3f3f3f3f3f3fULL);
+            return;
+        }
+        result[0] = Py_TOLOWER((unsigned char) cptr[0]);
+        if (len > 1) {
+            result[1] = Py_TOLOWER((unsigned char) cptr[1]);
+            if (len > 2) {
+                result[2] = Py_TOLOWER((unsigned char) cptr[2]);
+                if (len > 3) {
+                    result[3] = Py_TOLOWER((unsigned char) cptr[3]);
+                    if (len > 4) {
+                        result[4] = Py_TOLOWER((unsigned char) cptr[4]);
+                    }
+                }
+            }
+        }
+    }
+#else
     Py_ssize_t i;
 
     for (i = 0; i < len; i++) {
         result[i] = Py_TOLOWER((unsigned char) cptr[i]);
     }
+#endif
 }
 
 
