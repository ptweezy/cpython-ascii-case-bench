@@ -0,0 +1,5 @@
+Speed up :meth:`str.lower`, :meth:`str.upper` and :meth:`str.casefold` for
+ASCII strings, and :meth:`bytes.lower`, :meth:`bytes.upper` and
+:meth:`bytes.capitalize` (also on :class:`bytearray`), by converting several
+bytes at a time in x86-64 builds made with GCC or clang.
+Patch by Parker Loflin.
diff --git a/Objects/bytes_methods.c b/Objects/bytes_methods.c
index 414afeb..f675b06 100644
--- a/Objects/bytes_methods.c
+++ b/Objects/bytes_methods.c
@@ -242,6 +242,119 @@ _Py_bytes_istitle(const char *cptr, Py_ssize_t len)
 }
 
 
+/* Only GCC and clang on x86-64: MSVC stops inlining _Py_bytes_lower() into
+   its callers, aarch64 needs more instructions for short strings, riscv64
+   has slow unaligned loads, and 32-bit targets lack 64-bit registers. */
+#if defined(__GNUC__) && defined(__x86_64__)
+#define USE_ASCII_CASE
+/* Return x with 0x20 XORed into each byte valued first..first+25, given
+   0x80 - first and 0x80 - first - 26 in every byte of ge and gt.  For a
+   byte b < 0x80, b + ge has its high bit set iff b >= first, and b + gt
+   iff b > first + 25; neither sum carries.  "| x" drops bytes >= 0x80. */
+static inline Py_ALWAYS_INLINE uint64_t
+ascii_case_conv(uint64_t x, uint64_t ge, uint64_t gt)
+{
+    uint64_t b = x & 0x7f7f7f7f7f7f7f7fULL;
+    return x ^ (((b + ge) & ~((b + gt) | x) & 0x8080808080808080ULL) >> 2);
+}
+
+/* Convert len >= 16 bytes in 16-byte blocks, the last one ending at len.
+   gcc 16 with PGO vectorizes a block only as separate words, and clang with
+   _FORTIFY_SOURCE only as an array. */
+static Py_NO_INLINE void
+ascii_case_blocks(char *result, const char *cptr, Py_ssize_t len, uint64_t ge)
+{
+    uint64_t gt = ge - 26 * 0x0101010101010101ULL;
+    for (Py_ssize_t i = 0; ; i += 16) {
+        if (i > len - 16) {
+            if (i == len) {
+                break;
+            }
+            i = len - 16;
+        }
+#ifdef __clang__
+        uint64_t x[2];
+        memcpy(x, cptr + i, 16);
+        x[0] = ascii_case_conv(x[0], ge, gt);
+        x[1] = ascii_case_conv(x[1], ge, gt);
+        memcpy(result + i, x, 16);
+#else
+        uint64_t x, y;
+        memcpy(&x, cptr + i, 8);
+        memcpy(&y, cptr + i + 8, 8);
+        x = ascii_case_conv(x, ge, gt);
+        y = ascii_case_conv(y, ge, gt);
+        memcpy(result + i, &x, 8);
+        memcpy(result + i + 8, &y, 8);
+#endif
+    }
+}
+
+/* Convert 8 <= len < 16 bytes as two overlapping words. */
+static Py_NO_INLINE void
+ascii_case_words(char *result, const char *cptr, Py_ssize_t len, uint64_t ge)
+{
+    uint64_t gt = ge - 26 * 0x0101010101010101ULL;
+    uint64_t x, y;
+    memcpy(&x, cptr, 8);
+    memcpy(&y, cptr + len - 8, 8);
+    x = ascii_case_conv(x, ge, gt);
+    y = ascii_case_conv(y, ge, gt);
+    memcpy(result, &x, 8);
+    memcpy(result + len - 8, &y, 8);
+}
+
+/* Convert len >= 6 bytes: up to 7 as one word made of two overlapping
+   halves, up to 15 as two overlapping words, longer ones in 16-byte blocks. */
+static Py_NO_INLINE void
+ascii_case_long(char *result, const char *cptr, Py_ssize_t len, uint64_t ge)
+{
+    uint64_t gt = ge - 26 * 0x0101010101010101ULL;
+    if (len < 8) {
+        uint32_t a, b;
+        memcpy(&a, cptr, 4);
+        memcpy(&b, cptr + len - 4, 4);
+        uint64_t x = ascii_case_conv(a | ((uint64_t)b << 32), ge, gt);
+        memcpy(result, &x, 4);
+        memcpy(result + len - 4, (char *)&x + 4, 4);
+        return;
+    }
+    if (len >= 16) {
+        ascii_case_blocks(result, cptr, len, ge);
+        return;
+    }
+    ascii_case_words(result, cptr, len, ge);
+}
+
+/* Convert len bytes, given 0x80 - 'A' or 0x80 - 'a' in every byte of ge and
+   the Py_TOLOWER() or Py_TOUPPER() table: up to 5 one at a time, no loop. */
+static inline Py_ALWAYS_INLINE void
+ascii_case(char *result, const char *cptr, Py_ssize_t len, uint64_t ge,
+           const unsigned char (*table)[256])
+{
+    if (len > 0) {
+        if (len >= 6) {
+            ascii_case_long(result, cptr, len, ge);
+            return;
+        }
+        result[0] = (*table)[(unsigned char)cptr[0]];
+        if (len > 1) {
+            result[1] = (*table)[(unsigned char)cptr[1]];
+            if (len > 2) {
+                result[2] = (*table)[(unsigned char)cptr[2]];
+                if (len > 3) {
+                    result[3] = (*table)[(unsigned char)cptr[3]];
+                    if (len > 4) {
+                        result[4] = (*table)[(unsigned char)cptr[4]];
+                    }
+                }
+            }
+        }
+    }
+}
+#endif
+
+
